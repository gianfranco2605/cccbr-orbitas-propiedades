		{
			"name": "Privacy",
			"item": [
				{
					"name": "No secret-like or private keys in the payload",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}{{route}}?per_page=100",
							"host": [
								"{{base_url}}{{route}}"
							],
							"query": [
								{
									"key": "per_page",
									"value": "100"
								}
							]
						},
						"description": "Scans a full page for key names that must never appear, and checks that people objects carry only the allow-listed fields."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"",
									"const forbiddenKeys = [",
									"    'user_pass', 'user_login', 'user_activation_key', 'user_nicename', 'user_registered',",
									"    'password', 'passwd', 'pass', 'hash', 'token', 'secret', 'api_key', 'apikey',",
									"    'nonce', 'session_tokens', 'capabilities', 'wp_capabilities', 'roles', 'role',",
									"    'cedula', 'cedula_corredor', 'wasi', 'wasi_token', 'wasi_company',",
									"    'telefono', 'tel', 'phone', 'celular', 'whatsapp', 'direccion', 'address',",
									"    'fecha-de-nacimiento', 'birth', 'sexo', 'gender', 'estatus_de_pagos',",
									"    'foto-del-contrato', 'documentos-anexos', 'leads', 'lead'",
									"];",
									"",
									"const seen = new Set();",
									"const collect = (node) => {",
									"    if (Array.isArray(node)) { node.forEach(collect); return; }",
									"    if (node === null || typeof node !== 'object') { return; }",
									"    Object.keys(node).forEach(k => { seen.add(k.toLowerCase()); collect(node[k]); });",
									"};",
									"collect(body);",
									"",
									"pm.test('No forbidden key name appears anywhere in the payload', () => {",
									"    const found = forbiddenKeys.filter(k => seen.has(k.toLowerCase()));",
									"    pm.expect(found, 'forbidden keys found: ' + found.join(', ')).to.eql([]);",
									"});",
									"",
									"pm.test('People objects carry only the allow-listed fields', () => {",
									"    body.data.forEach(p => {",
									"        if (p.creator) { pm.expect(Object.keys(p.creator).sort()).to.eql(['display_name', 'email', 'id']); }",
									"        if (p.responsible) { pm.expect(Object.keys(p.responsible).sort()).to.eql(['display_name', 'email', 'id']); }",
									"        if (p.company) { pm.expect(Object.keys(p.company).sort()).to.eql(['display_name', 'id']); }",
									"    });",
									"});",
									"",
									"pm.test('Private documents are booleans, never files or ids', () => {",
									"    body.data.forEach(p => {",
									"        pm.expect(Object.keys(p.private_documents).sort()).to.eql(['has_attachments', 'has_contract_photo']);",
									"        pm.expect(p.private_documents.has_contract_photo).to.be.a('boolean');",
									"        pm.expect(p.private_documents.has_attachments).to.be.a('boolean');",
									"    });",
									"});",
									"",
									"pm.test('Leads are a count, never content', () => {",
									"    body.data.forEach(p => pm.expect(p.leads_count).to.be.a('number'));",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Schema is published",
					"request": {
						"method": "OPTIONS",
						"url": {
							"raw": "{{base_url}}{{route}}",
							"host": [
								"{{base_url}}{{route}}"
							]
						},
						"description": "A consumer can generate types from the live endpoint instead of transcribing the contract."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('The collection schema is served', () => {",
									"    pm.expect(body.schema.title).to.eql('cccbr_orbitas_propiedades_collection');",
									"    pm.expect(Object.keys(body.schema.properties).sort()).to.eql(['data', 'generated_at', 'pagination', 'totals']);",
									"});",
									"pm.test('The three arguments are documented', () => {",
									"    pm.expect(Object.keys(body.endpoints[0].args).sort()).to.eql(['after_id', 'per_page', 'status']);",
									"    pm.expect(body.endpoints[0].args.per_page.maximum).to.eql(100);",
									"});"
								]
							}
						}
					]
				}
			]
		}
