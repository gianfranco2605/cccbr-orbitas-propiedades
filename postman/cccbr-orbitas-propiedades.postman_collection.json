					]
				}
			]
		},
		{
			"name": "Full walk",
			"item": [
				{
					"name": "Walk page",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}{{route}}?per_page=100&after_id={{cursor}}",
							"host": [
								"{{base_url}}{{route}}"
							],
							"query": [
								{
									"key": "per_page",
									"value": "100"
								},
								{
									"key": "after_id",
									"value": "{{cursor}}"
								}
							]
						},
						"description": "Loops over itself until has_more is false, then checks that the walk saw every property exactly once. Run it through the Collection Runner — a single send only fetches one page."
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.collectionVariables.get('walked_pages') === '0') {",
									"    pm.collectionVariables.set('cursor', '0');",
									"    pm.collectionVariables.set('walked_count', '0');",
									"}"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"const ids = body.data.map(p => p.id);",
									"const cursor = Number(pm.collectionVariables.get('cursor'));",
									"",
									"pm.test('Every id is above the cursor', () => ids.forEach(id => pm.expect(id).to.be.above(cursor)));",
									"pm.test('Ids ascend and do not repeat', () => {",
									"    pm.expect(ids).to.eql([...ids].sort((a, b) => a - b));",
									"    pm.expect(new Set(ids).size).to.eql(ids.length);",
									"});",
									"",
									"const count = Number(pm.collectionVariables.get('walked_count')) + ids.length;",
									"const pages = Number(pm.collectionVariables.get('walked_pages')) + 1;",
									"",
									"pm.collectionVariables.set('walked_count', String(count));",
									"pm.collectionVariables.set('walked_pages', String(pages));",
									"",
									"if (body.pagination.has_more === true && pages < 500) {",
									"    pm.collectionVariables.set('cursor', String(body.pagination.next_after_id));",
									"    postman.setNextRequest('Walk page');",
									"    return;",
									"}",
									"",
									"pm.test('The last page reports no more and a null-free cursor', () => {",
									"    pm.expect(body.pagination.has_more).to.eql(false);",
									"});",
									"",
									"pm.test('The walk returned every property exactly once', () => {",
									"    pm.expect(count).to.eql(body.totals.total);",
									"});",
									"",
									"console.log('walked ' + count + ' properties over ' + pages + ' pages');",
									"pm.collectionVariables.set('walked_pages', '0');"
								]
							}
						}
					]
				},
				{
					"name": "Past the end",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}{{route}}?per_page=100&after_id=99999999",
							"host": [
								"{{base_url}}{{route}}"
							],
							"query": [
								{
									"key": "per_page",
									"value": "100"
								},
								{
									"key": "after_id",
									"value": "99999999"
								}
							]
						},
						"description": "Walking past the last id must end the walk cleanly, not error."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK, not 404', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('Empty page closes the walk', () => {",
									"    pm.expect(body.data).to.eql([]);",
									"    pm.expect(body.pagination.has_more).to.eql(false);",
									"    pm.expect(body.pagination.next_after_id).to.eql(null);",
									"});",
									"pm.test('Totals still describe the whole set', () => pm.expect(body.totals.total).to.be.above(0));"
								]
							}
						}
					]
				},
				{
					"name": "Zero results",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}{{route}}?status=pending",
							"host": [
								"{{base_url}}{{route}}"
							],
							"query": [
								{
									"key": "status",
									"value": "pending"
								}
							]
						},
						"description": "A filter that matches nothing is an empty 200, never a 404."
