{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(~/Projects/cccbr-replica/wp-content/plugins/**)",
      "Read(~/Projects/cccbr-replica/wp-content/mu-plugins/**)",
      "Read(~/Projects/cccbr-replica/wp-content/themes/**)",
      "Read(~/Projects/cccbr-replica/compose.yaml)",
      "Bash(docker compose -f ~/Projects/cccbr-replica/compose.yaml run --rm wpcli wp:*)",
      "Bash(docker compose -f ~/Projects/cccbr-replica/compose.yaml exec wordpress php:*)",
      "Bash(docker compose -f ~/Projects/cccbr-replica/compose.yaml logs:*)",
      "Bash(docker compose -f ~/Projects/cccbr-replica/compose.yaml ps:*)",
      "Bash(curl -s http://localhost:8080:*)",
      "Bash(curl -sS http://localhost:8080:*)",
      "Bash(curl -s -o /dev/null -w:*)",
      "Bash(curl -s -i http://localhost:8080:*)",
      "Bash(curl -s -i -u:*)",
      "Bash(curl -sS -u:*)",
      "Bash(curl -s -u:*)",
      "Bash(php -v)",
      "Bash(php -l:*)",
      "Bash(composer -V)",
      "Bash(composer validate:*)",
      "Bash(composer install:*)",
      "Bash(composer dump-autoload:*)",
      "Bash(vendor/bin/phpcs:*)",
      "Bash(vendor/bin/phpcbf:*)",
      "Bash(vendor/bin/phpstan:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(mkdir:*)",
      "Bash(which:*)",
      "Bash(wc:*)",
      "Bash(composer lint:*)",
      "Bash(composer cs:*)",
      "Bash(composer cbf:*)",
      "Bash(composer stan:*)",
      "Bash(composer test:*)",
      "Bash(composer run:*)",
      "Bash(test -n:*)",
      "Bash(printenv CCCBR_API_USER)",
      "Bash(docker compose -f ~/Projects/cccbr-replica/compose.yaml exec wordpress test:*)",
      "Bash(git config user.name)",
      "Bash(git config user.email)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(git --version)",
      "Bash(pwd)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(composer require:*)",
      "Bash(composer update:*)",
      "Bash(docker run:*)",
      "Bash(rm:*)",
      "Bash(mv:*)"
    ],
    "deny": [
      "Read(~/Projects/cccbr-replica/database.sql.gz)",
      "Read(~/Projects/cccbr-replica/*.sql)",
      "Read(~/Projects/cccbr-replica/*.sql.gz)",
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(sftp:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo:*)",
      "Bash(docker compose -f ~/Projects/cccbr-replica/compose.yaml down -v:*)",
      "Bash(docker compose -f ~/Projects/cccbr-replica/compose.yaml down --volumes:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker system prune:*)",
      "Bash(docker rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(curl *camara.cr*)",
      "Bash(wget:*)",
      "WebFetch(domain:camara.cr)",
      "WebFetch(domain:www.camara.cr)",
      "WebFetch(domain:tienda.camara.cr)",
      "Bash(*database.sql*)",
      "Bash(*.sql.gz*)",
      "Bash(zcat:*)",
      "Bash(gunzip:*)",
      "Bash(gzip:*)",
      "Bash(printenv CCCBR_API_APP_PASSWORD*)",
      "Bash(echo $CCCBR_API_APP_PASSWORD*)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(printenv CCCBR_API_NOACCESS_APP_PASSWORD*)",
      "Bash(echo $CCCBR_API_NOACCESS_APP_PASSWORD*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -execdir*)",
      "Bash(cd *)",
      "Bash(cat ~/.ssh*)",
      "Bash(cat *.env*)"
    ]
  }
}
