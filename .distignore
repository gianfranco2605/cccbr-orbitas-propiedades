# Files and folders that must NOT ship in the production zip.
#
# Read by `tools/build.php` (`composer run build`). One entry per line; a line matches a path
# relative to the plugin root, either exactly or as a directory prefix. Comments and blank lines
# are ignored.
#
# What the zip DOES contain, and why:
#   cccbr-orbitas-propiedades.php  the plugin header and bootstrap
#   uninstall.php                  removes the capability on uninstall
#   src/                           the plugin itself
#   vendor/                        REQUIRED AT RUNTIME: the main file includes
#                                  vendor/autoload.php and does nothing without it. After
#                                  `composer install --no-dev` this is only Composer's own
#                                  autoloader — the plugin has no production dependencies.
#   readme.txt / README.md         kept so the installed plugin can be identified
#   LICENSE                        if present
#   languages/                     if present

# Version control and CI
.git
.gitignore
.gitattributes
.github
.distignore

# Claude Code
.claude
CLAUDE.md
LOOP_PROMPT.md

# Dependency manifests: needed to BUILD, never shipped. tools/build.php copies them into the
# temporary build directory, runs `composer install --no-dev --optimize-autoloader` there, and
# deletes them again before zipping.
composer.json
composer.lock

# Development tooling configuration
phpcs.xml.dist
phpcs.xml
phpstan.neon.dist
phpstan.neon
phpunit.xml.dist
phpunit.xml
.phpunit.result.cache
.phpunit.cache
.phpcs-cache

# Tests, build tooling, working documentation and API client collections
tests
tools
docs
postman

# Build output
dist

# OS and editor noise
.DS_Store
Thumbs.db
.idea
.vscode
